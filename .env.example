# Telegram
BOT_TOKEN=
# Telegram user ID of the owner (admin)
ADMIN_ID=
# Optional second user who owns GUEST_DOMAIN
GUEST_ID=

# Domains
MAIL_DOMAIN=example.com
GUEST_DOMAIN=guest.example.com
# Per-person subdomains: "domain:telegram_id,domain:telegram_id"
DOMAIN_OWNERS=team.example.com:111111111

# Outgoing mail
MAIL_SIGNATURE=

# Retention
MAIL_TTL_DAYS=180
CLEANUP_TIME=04:30
CLEANUP_GRACE_DAYS=3

# Mini App (leave WEBAPP_URL empty to use chat dialogs instead)
WEBAPP_DOMAIN=mail.example.com
WEBAPP_URL=

# Digest and monitoring
DIGEST_TIME=09:00
DIGEST_TZ=Europe/Kyiv
HEALTH_CHECK_MINUTES=5
DISK_ALERT_PCT=90
MEM_ALERT_MB=100
SWAP_ALERT_PCT=85
CERT_ALERT_DAYS=14

# Backups
BACKUP_KEEP_DAYS=14
BACKUP_TG_WEEKDAY=6
BACKUP_TG_TIME=05:00

# Attachments and stored HTML
BLOB_ATTACH_MAX_MB=5
BLOB_HTML_MAX_KB=512
BLOB_TTL_DAYS=30
BLOB_MAX_MB=300
BLOB_PER_MAIL_MB=20
BLOB_MIN_FREE_MB=500

# Hide one-time codes in the Telegram message after N minutes, 0 = off
OTP_HIDE_MINUTES=15
